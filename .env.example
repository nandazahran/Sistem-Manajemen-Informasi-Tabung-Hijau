# Template konfigurasi aplikasi SIM-TH
# Cara pakai: Copy file ini, ubah namanya menjadi .env, dan ganti nilai di dalam kurung siku

# --- KONFIGURASI DATABASE (DOCKER) ---
DB_USER=admin_sim_th
DB_PASSWORD=password_development_jangan_dipakai_di_prod
DB_NAME=db_sim_th

# --- KONFIGURASI BACKEND (RUST) ---
DATABASE_URL=postgres://admin_sim_th:password_development_jangan_dipakai_di_prod@localhost:5433/db_sim_th

# 🔑 JWT SECRET (Bisa dibiarkan untuk local development)
JWT_SECRET=rahasia_kunci_jwt_lokal_sim_th_jangan_dipakai_di_prod

# 📧 KONFIGURASI SMTP (EMAIL OTP)
# Untuk testing lokal, gunakan Google App Password milikmu sendiri,
# atau gunakan layanan testing seperti Mailtrap.io
SMTP_HOST=smtp.gmail.com
SMTP_EMAIL=[masukkan_email_testing_disini]
SMTP_PASSWORD=[masukkan_app_password_tanpa_spasi_disini]

# --- KONFIGURASI FRONTEND (VITE) ---
# URL Base untuk hit API dari frontend
VITE_API_URL=http://localhost:3000/api

# --- KONFIGURASI CLOUDFLARE TUNNEL (OPSIONAL) ---
# Diperlukan hanya saat deploy ke production dengan Cloudflare Tunnel
CLOUDFLARE_TOKEN=[MASUKKAN_TOKEN_CLOUDFLARE_DISINI]